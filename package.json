{
  "name": "unspoken",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Anonymous wall for the things left unspoken.",
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "NODE_ENV=production bun run build.ts",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "serve": "NODE_ENV=production bun run build.ts && NODE_ENV=production bun run src/server/index.ts",
    "migrate": "bun run migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "hono": "^4.6.15",
    "lenis": "^1.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "bun-types": "^1.3.14",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
