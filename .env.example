# ---- Postgres (self-hosted, runs in docker-compose) ------------------------
# These three define the postgres container. DATABASE_URL must match them and
# use the service name `postgres` as the host (internal compose network).
POSTGRES_USER=unspoken
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=unspoken
DATABASE_URL=postgres://unspoken:change-me-strong-db-password@postgres:5432/unspoken
# Connections per app process. Keep (replicas x this) well under max_connections.
PG_POOL_MAX=10

# ---- Redis (self-hosted, runs in docker-compose) ---------------------------
# Powers SSE fan-out so you can scale to multiple app replicas. Password must
# match REDIS_URL. Leave REDIS_URL empty to run single-instance without Redis.
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379

# ---- App -------------------------------------------------------------------
# Random secret that salts IP hashes (openssl rand -hex 32). Required in prod.
IP_SALT=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=production
# Absolute production URL, no trailing slash. Powers canonical / OG / sitemap.
PUBLIC_SITE_URL=https://unspoken.zone
# Admin dashboard at /rootunspoken (monitor + delete flagged letters).
# Leave ADMIN_PASS empty to disable the dashboard. Use a long random password.
ADMIN_USER=root
ADMIN_PASS=
# Letters auto-expire after this many days (not surfaced in the UI).
RETENTION_DAYS=30

# ---- Cloudflare Tunnel -----------------------------------------------------
# Token from Cloudflare Zero Trust > Networks > Tunnels. Only used by compose.
CF_TUNNEL_TOKEN=
