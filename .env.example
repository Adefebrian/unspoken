# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Random secret used to salt IP hashes (openssl rand -hex 32)
IP_SALT="change-me-to-a-long-random-string"
# Port the Bun/Hono server listens on
PORT=3000
NODE_ENV=production
# Absolute production URL (no trailing slash). Powers canonical, OpenGraph,
# sitemap.xml and llms.txt. Set this to your real domain in production.
PUBLIC_SITE_URL=https://your-domain.com
# Admin dashboard at /rootunspoken (monitor + delete flagged letters).
# Leave unset to disable the dashboard entirely. Use a long random password.
ADMIN_USER=root
ADMIN_PASS=
# Letters auto-expire after this many days (not surfaced in the UI).
RETENTION_DAYS=30
# Cloudflare Tunnel token (from Zero Trust > Tunnels). Only for docker-compose deploy.
CF_TUNNEL_TOKEN=
